#!/bin/sh
# claudes — cohesive CLI for Claude profiles. One authoritative implementation;
# the tray app shells out to this for anything with side effects.
#
#   claudes list                          profiles (✓ active, 🟢 running)
#   claudes active                        print the active profile name
#   claudes use <Profile|Default>         switch the GLOBAL active profile
#   claudes run <Profile|Default> [args]  run Claude Code pinned to a profile
#   claudes new <Name>                    create a profile (app clone + config dir)
#   claudes delete <Name> [--everything] [--yes]
#   claudes repatch [Name]                rebuild clone(s) after a Claude update
#   claudes sessions [Profile|Default]    list Claude Code sessions
#   claudes transfer <session-id> --to <Profile> [--from <Profile>]
#   claudes desktop [Name]                open the desktop app
#   claudes version
#
# Global switching: ~/.claude becomes a symlink into ~/.claude-profiles/, so
# every consumer of the default config dir (CLI, editors, IDE plugins) follows
# it. First `use` migrates the real ~/.claude to ~/.claude-profiles/Default.
# CLAUDE_CONFIG_DIR still overrides per-invocation (claude-as / claude-<name>).
#
# POSIX sh on purpose — no zsh/bashisms; callers can be any shell.
set -eu

root="$HOME/.claude-profiles"
dot="$HOME/.claude"
# Resolve symlinks (install.sh links this onto PATH) so sibling scripts and
# the bundle Info.plist are found next to the real file, not the link.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")
scripts_dir=$(dirname "$self")

die() { echo "claudes: $*" >&2; exit 1; }

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# All profile names: config dirs ∪ app clones (one per line, sorted, unique).
profile_names() {
  {
    if [ -d "$root" ]; then
      for d in "$root"/*/; do
        [ -d "$d" ] || continue
        basename "$d"
      done
    fi
    for a in /Applications/Claude-*.app; do
      [ -d "$a" ] || continue
      b=$(basename "$a" .app)
      echo "${b#Claude-}"
    done
  } | sort -fu
}

# Case-insensitive name -> canonical name. "default" is always valid.
resolve_profile() {
  want=$(lower "$1")
  if [ "$want" = default ]; then echo "Default"; return 0; fi
  profile_names | while IFS= read -r n; do
    if [ "$(lower "$n")" = "$want" ]; then echo "$n"; fi
  done | head -1 | grep . || return 1
}

# Config dir for a profile. Default = migrated dir if ~/.claude is a symlink,
# else ~/.claude itself.
config_dir() {
  if [ "$1" = Default ]; then
    if [ -L "$dot" ]; then echo "$root/Default"; else echo "$dot"; fi
  else
    echo "$root/$1"
  fi
}

active_profile() {
  if [ -L "$dot" ]; then
    basename "$(readlink "$dot")"
  else
    echo "Default"
  fi
}

profile_running() {  # desktop app instance
  if [ "$1" = Default ]; then
    pgrep -f "/Applications/Claude.app/Contents/MacOS/Claude" >/dev/null 2>&1
  else
    pgrep -f "user-data-dir=$HOME/Library/Application Support/Claude-$1" >/dev/null 2>&1
  fi
}

cmd_list() {
  act=$(active_profile)
  { echo "Default"; profile_names; } | sort -fu | while IFS= read -r n; do
    if [ "$n" = "$act" ]; then mark="✓"; else mark=" "; fi
    if profile_running "$n"; then run="🟢"; else run="⚪️"; fi
    echo "$mark $run $n"
  done
}

cmd_use() {
  [ $# -ge 1 ] || die "usage: claudes use <Profile|Default>"
  name=$(resolve_profile "$1") || die "no profile named '$1' (see: claudes list)"

  # One-time migration: real ~/.claude -> ~/.claude-profiles/Default.
  if [ -e "$dot" ] && [ ! -L "$dot" ]; then
    [ -e "$root/Default" ] && die "both $dot and $root/Default exist — merge or remove one, then retry"
    mkdir -p "$root"
    mv "$dot" "$root/Default"
    echo "Migrated $dot -> $root/Default"
  fi

  target=$(config_dir "$name")
  [ "$name" = Default ] || mkdir -p "$target"
  [ -d "$target" ] || die "profile config dir missing: $target"
  rm -f "$dot"
  ln -s "$target" "$dot"
  echo "Active profile: $name  ($dot -> $target)"
  echo "New sessions everywhere use it; running sessions keep the profile they started with."
  [ -n "${CLAUDE_CONFIG_DIR:-}" ] && \
    echo "note: CLAUDE_CONFIG_DIR is set in this shell and overrides the global switch here."
  true
}

cmd_run() {
  [ $# -ge 1 ] || die "usage: claudes run <Profile|Default> [claude args...]"
  name=$(resolve_profile "$1") || die "no profile named '$1' (see: claudes list)"
  shift
  command -v claude >/dev/null 2>&1 || die "Claude Code CLI not found — install it: npm install -g @anthropic-ai/claude-code"
  CLAUDE_CONFIG_DIR=$(config_dir "$name") exec claude "$@"
}

cmd_new() {
  [ $# -ge 1 ] || die "usage: claudes new <Name>"
  exec "$scripts_dir/make-claude-profile.sh" "$1"
}

cmd_repatch() {
  exec "$scripts_dir/repatch-claude-profiles.sh" "$@"
}

cmd_delete() {
  name="" everything=0 yes=0
  for arg in "$@"; do
    case $arg in
      --everything) everything=1 ;;
      --yes) yes=1 ;;
      -*) die "unknown flag: $arg" ;;
      *) name=$arg ;;
    esac
  done
  [ -n "$name" ] || die "usage: claudes delete <Name> [--everything] [--yes]"
  name=$(resolve_profile "$name") || die "no profile named '$name'"
  [ "$name" = Default ] && die "Default can't be deleted"
  [ "$(active_profile)" = "$name" ] && die "'$name' is the active profile — run 'claudes use <other>' first"
  profile_running "$name" && die "'$name' is running — quit it first"

  app="/Applications/Claude-$name.app"
  data="$HOME/Library/Application Support/Claude-$name"
  cfg="$root/$name"
  if [ "$yes" -eq 0 ]; then
    if [ "$everything" -eq 1 ]; then extra=" AND its data/config"; else extra=""; fi
    printf "Delete profile '%s'%s? [y/N] " "$name" "$extra"
    read -r reply
    case $(lower "$reply") in y*) ;; *) echo "aborted"; exit 1 ;; esac
  fi
  [ -d "$app" ] && rm -rf "$app"
  if [ "$everything" -eq 1 ]; then
    [ -d "$data" ] && rm -rf "$data"
    [ -d "$cfg" ] && rm -rf "$cfg"
    echo "Deleted '$name' (app, data, config)"
  else
    echo "Deleted '$name' (app only)"
  fi
}

# First "cwd" and first user prompt from the head of a session transcript.
session_meta() {  # path -> cwd \t snippet
  head=$(head -c 16384 "$1" 2>/dev/null || true)
  cwd=$(printf '%s' "$head" | grep -o '"cwd":"[^"]*"' | head -1 | sed 's/^"cwd":"//; s/"$//')
  snippet=$(printf '%s' "$head" | grep -o '"content":"[^"]*' | head -1 | cut -c12- | cut -c1-70)
  if [ -z "$snippet" ]; then
    snippet=$(printf '%s' "$head" | grep -o '"text":"[^"]*' | head -1 | cut -c9- | cut -c1-70)
  fi
  printf '%s\t%s\n' "$cwd" "${snippet:-(no prompt)}"
}

cmd_sessions() {
  name=$(resolve_profile "${1:-Default}") || die "no profile named '$1'"
  cfg=$(config_dir "$name")
  found=0
  # shellcheck disable=SC2045
  for f in "$cfg"/projects/*/*.jsonl; do
    [ -e "$f" ] || continue
    found=1
    stat -f '%m %N' "$f"
  done | sort -rn | while IFS= read -r line; do
    f=${line#* }
    meta=$(session_meta "$f")
    cwd=${meta%%	*}
    if [ -n "$cwd" ]; then proj=$(basename "$cwd"); else proj=$(basename "$(dirname "$f")"); fi
    id=$(basename "$f" .jsonl)
    printf '%s  %s  %-20s  %s\n' \
      "$id" \
      "$(date -r "${line%% *}" '+%Y-%m-%d %H:%M')" \
      "$proj" \
      "${meta#*	}"
  done
  # The pipeline runs in a subshell; re-check emptiness directly.
  for f in "$cfg"/projects/*/*.jsonl; do
    [ -e "$f" ] && return 0
  done
  die "no sessions in '$name' ($cfg/projects)"
}

cmd_transfer() {
  id="" from="" to="" prev=""
  for arg in "$@"; do
    case $prev in
      --to) to=$arg; prev=""; continue ;;
      --from) from=$arg; prev=""; continue ;;
    esac
    case $arg in
      --to|--from) prev=$arg ;;
      -*) die "unknown flag: $arg" ;;
      *) id=$arg ;;
    esac
  done
  { [ -n "$id" ] && [ -n "$to" ]; } || die "usage: claudes transfer <session-id> --to <Profile> [--from <Profile>]"
  to=$(resolve_profile "$to") || die "no profile named '$to'"

  # Locate the source transcript: given profile, or search all of them.
  src_cfg="" jsonl=""
  if [ -n "$from" ]; then
    from=$(resolve_profile "$from") || die "no profile named '$from'"
    src_cfg=$(config_dir "$from")
    for f in "$src_cfg"/projects/*/"$id".jsonl; do
      [ -e "$f" ] && jsonl=$f && break
    done
    [ -n "$jsonl" ] || die "session $id not found in '$from'"
  else
    for n in $( { echo Default; profile_names; } | sort -fu ); do
      cfg=$(config_dir "$n")
      for f in "$cfg"/projects/*/"$id".jsonl; do
        [ -e "$f" ] && from=$n && src_cfg=$cfg && jsonl=$f && break
      done
      [ -n "$jsonl" ] && break
    done
    [ -n "$jsonl" ] || die "session $id not found in any profile"
  fi
  [ "$from" = "$to" ] && die "session is already in '$to'"

  dst_cfg=$(config_dir "$to")
  slug=$(basename "$(dirname "$jsonl")")
  dst="$dst_cfg/projects/$slug/$id.jsonl"
  [ -e "$dst" ] && die "'$to' already has session $id"
  mkdir -p "$dst_cfg/projects/$slug"
  mv "$jsonl" "$dst"

  # Per-session side data (env, edited-file history, todos) — best-effort.
  for sub in "session-env/$id" "file-history/$id"; do
    if [ -e "$src_cfg/$sub" ] && [ ! -e "$dst_cfg/$sub" ]; then
      mkdir -p "$dst_cfg/$(dirname "$sub")"
      mv "$src_cfg/$sub" "$dst_cfg/$sub" 2>/dev/null || true
    fi
  done
  for f in "$src_cfg"/todos/"$id"*; do
    [ -e "$f" ] || continue
    mkdir -p "$dst_cfg/todos"
    mv "$f" "$dst_cfg/todos/" 2>/dev/null || true
  done

  cwd=$(session_meta "$dst" | cut -f1)
  # env-prefix form works in zsh, bash, AND fish (VAR=x cmd does not).
  if [ "$to" = Default ] && [ ! -L "$dot" ]; then
    invoke="claude --resume $id"
  else
    invoke="env CLAUDE_CONFIG_DIR=\"\$HOME/.claude-profiles/$to\" claude --resume $id"
  fi
  echo "Moved session $id: $from -> $to"
  if [ -n "$cwd" ]; then
    echo "Resume: cd \"$cwd\" && $invoke"
  else
    echo "Resume: $invoke"
  fi
}

cmd_desktop() {
  name=$(resolve_profile "${1:-Default}") || die "no profile named '$1'"
  if [ "$name" = Default ]; then
    open -a "/Applications/Claude.app"
  else
    open -a "/Applications/Claude-$name.app"
  fi
}

cmd_version() {
  plist="$scripts_dir/../Info.plist"
  if [ -f "$plist" ]; then
    /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist"
  else
    git -C "$scripts_dir" describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || echo "0.0.0"
  fi
}

cmd_help() {
  sed -n '5,16p' "$self" | sed 's/^# \{0,3\}//'
}

cmd=${1:-help}
[ $# -ge 1 ] && shift
case $cmd in
  list)     cmd_list "$@" ;;
  active)   active_profile ;;
  use)      cmd_use "$@" ;;
  run)      cmd_run "$@" ;;
  new)      cmd_new "$@" ;;
  delete)   cmd_delete "$@" ;;
  repatch)  cmd_repatch "$@" ;;
  sessions) cmd_sessions "$@" ;;
  transfer) cmd_transfer "$@" ;;
  desktop)  cmd_desktop "$@" ;;
  version)  cmd_version ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command: $cmd (try: claudes help)" ;;
esac
