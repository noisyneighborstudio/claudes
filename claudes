#!/bin/sh
# claudes — cohesive CLI for Claude profiles. One authoritative implementation;
# the tray app shells out to this for anything with side effects.
#
#   claudes list                          profiles (✓ active, 🟢 running)
#   claudes active                        print the active profile name
#   claudes use <Profile|Default>         switch the GLOBAL active profile
#   claudes run <Profile|--next|--best> [--start-from-session=<id>] [args]
#   claudes best                          per-profile usage (5h/7d windows)
#   claudes new <Name>                    create a profile (app clone + config dir)
#   claudes delete <Name> [--everything] [--yes]
#   claudes repatch [Name]                rebuild clone(s) after a Claude update
#   claudes sessions [Profile|Default]    list Claude Code sessions
#   claudes transfer <id> --to <Profile>|--next|--best [--from <Profile>]
#   claudes desktop [Name|--next|--best]  open the desktop app
#   claudes shims [--remove]              sync claude-as / claude-<profile> on PATH
#   claudes version
#
# Global switching: ~/.claude becomes a symlink into ~/.claude-profiles/, so
# every consumer of the default config dir (CLI, editors, IDE plugins) follows
# it. First `use` migrates the real ~/.claude to ~/.claude-profiles/Default.
# CLAUDE_CONFIG_DIR still overrides per-invocation (claude-as / claude-<name>).
#
# POSIX sh on purpose — no zsh/bashisms; callers can be any shell.
set -eu

root="$HOME/.claude-profiles"
dot="$HOME/.claude"
# Resolve symlinks (install.sh links this onto PATH) so sibling scripts and
# the bundle Info.plist are found next to the real file, not the link.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")
scripts_dir=$(dirname "$self")

die() { echo "claudes: $*" >&2; exit 1; }

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

valid_profile_name() {
  [ -n "$1" ] || return 1
  clean=$(printf '%s' "$1" | LC_ALL=C tr -cd 'A-Za-z0-9')
  [ "$clean" = "$1" ] || return 1
  case $(lower "$1") in default) return 1 ;; *) return 0 ;; esac
}

# All profile names: config dirs ∪ app clones (one per line, sorted, unique).
profile_names() {
  {
    if [ -d "$root" ]; then
      for d in "$root"/*/; do
        [ -d "$d" ] || continue
        name=${d%/}
        name=${name##*/}
        if valid_profile_name "$name"; then echo "$name"; fi
      done
    fi
    for a in /Applications/Claude-*.app; do
      [ -d "$a" ] || continue
      b=${a##*/}
      b=${b%.app}
      name=${b#Claude-}
      if valid_profile_name "$name"; then echo "$name"; fi
    done
  } | sort -fu
}

# Case-insensitive name -> canonical name. "default" is always valid.
resolve_profile() {
  want=$(lower "$1")
  if [ "$want" = default ]; then echo "Default"; return 0; fi
  profile_names | while IFS= read -r n; do
    if [ "$(lower "$n")" = "$want" ]; then echo "$n"; fi
  done | head -1 | grep . || return 1
}

# Config dir for a profile. Default = migrated dir if ~/.claude is a symlink,
# else ~/.claude itself.
config_dir() {
  if [ "$1" = Default ]; then
    if [ -L "$dot" ]; then echo "$root/Default"; else echo "$dot"; fi
  else
    echo "$root/$1"
  fi
}

active_profile() {
  if [ -L "$dot" ]; then
    basename "$(readlink "$dot")"
  else
    echo "Default"
  fi
}

profile_running() {  # desktop app instance
  if [ "$1" = Default ]; then
    pgrep -f "/Applications/Claude.app/Contents/MacOS/Claude" >/dev/null 2>&1
  else
    pgrep -f "user-data-dir=$HOME/Library/Application Support/Claude-$1" >/dev/null 2>&1
  fi
}

cmd_list() {
  act=$(active_profile)
  { echo "Default"; profile_names; } | sort -fu | while IFS= read -r n; do
    if [ "$n" = "$act" ]; then mark="✓"; else mark=" "; fi
    if profile_running "$n"; then run="🟢"; else run="⚪️"; fi
    echo "$mark $run $n"
  done
}

cmd_use() {
  [ $# -ge 1 ] || die "usage: claudes use <Profile|Default>"
  name=$(resolve_profile "$1") || die "no profile named '$1' (see: claudes list)"

  # One-time migration: real ~/.claude -> ~/.claude-profiles/Default.
  if [ -e "$dot" ] && [ ! -L "$dot" ]; then
    [ -e "$root/Default" ] && die "both $dot and $root/Default exist — merge or remove one, then retry"
    mkdir -p "$root"
    mv "$dot" "$root/Default"
    echo "Migrated $dot -> $root/Default"
  fi

  target=$(config_dir "$name")
  [ "$name" = Default ] || mkdir -p "$target"
  [ -d "$target" ] || die "profile config dir missing: $target"
  rm -f "$dot"
  ln -s "$target" "$dot"
  echo "Active profile: $name  ($dot -> $target)"
  echo "New sessions everywhere use it; running sessions keep the profile they started with."
  [ -n "${CLAUDE_CONFIG_DIR:-}" ] && \
    echo "note: CLAUDE_CONFIG_DIR is set in this shell and overrides the global switch here."
  true
}

# Round-robin over all profiles (Default included), shared by `run --next`
# and `desktop --next`. The pointer is the last profile handed out.
rotation_next() {
  state_file="$root/.rotation"
  names=$({ echo Default; profile_names; } | sort -fu)
  last=""
  [ -f "$state_file" ] && last=$(cat "$state_file" 2>/dev/null)
  next="" take_next=0
  for n in $names; do
    if [ "$take_next" = 1 ]; then next=$n; break; fi
    [ "$n" = "$last" ] && take_next=1
  done
  [ -n "$next" ] || next=$(printf '%s\n' "$names" | head -1)
  mkdir -p "$root"
  printf '%s' "$next" > "$state_file"
  echo "$next"
}

# Server-side usage per profile, from the same OAuth endpoint the CLI's /usage
# screen reads. Ground truth (includes web/desktop/other machines), not a local
# heuristic. Prints: name<TAB>5h%<TAB>7d%<TAB>5h-resets<TAB>note
usage_table() {
  ut_args=""
  for n in $( { echo Default; profile_names; } | sort -fu ); do
    ut_args="$ut_args $n=$(config_dir "$n")"
  done
  # shellcheck disable=SC2086
  /usr/bin/python3 - $ut_args <<'PYEOF'
import hashlib, json, subprocess, sys, time, urllib.request

def creds(cfg, is_default):
    # Keychain service is "Claude Code-credentials[-<sha256(cfgdir)[:8]>]";
    # the unsuffixed entry belongs to the default ~/.claude config dir.
    svcs = ['Claude Code-credentials-' + hashlib.sha256(cfg.encode()).hexdigest()[:8]]
    if is_default:
        svcs.insert(0, 'Claude Code-credentials')
    found = None
    for svc in svcs:
        p = subprocess.run(['security', 'find-generic-password', '-s', svc, '-w'],
                           capture_output=True, text=True)
        if p.returncode == 0:
            try:
                c = json.loads(p.stdout.strip()).get('claudeAiOauth', {})
            except ValueError:
                continue
            if c.get('accessToken'):
                found = c
                if c.get('expiresAt', 0) / 1000 > time.time():
                    return c, 'ok'
    try:
        c = json.load(open(cfg + '/.credentials.json')).get('claudeAiOauth', {})
        if c.get('accessToken'):
            if c.get('expiresAt', 0) / 1000 > time.time():
                return c, 'ok'
            found = found or c
    except (OSError, ValueError):
        pass
    return (found, 'stale-token') if found else (None, 'no-token')

for pair in sys.argv[1:]:
    name, cfg = pair.split('=', 1)
    c, status = creds(cfg, name == 'Default')
    if status != 'ok':
        print(f"{name}\t-\t-\t-\t{status}")
        continue
    req = urllib.request.Request('https://api.anthropic.com/api/oauth/usage',
        headers={'Authorization': 'Bearer ' + c['accessToken'],
                 'anthropic-beta': 'oauth-2025-04-20', 'User-Agent': 'claudes'})
    try:
        r = json.load(urllib.request.urlopen(req, timeout=10))
        five = r.get('five_hour') or {}
        seven = r.get('seven_day') or {}
        print(f"{name}\t{five.get('utilization', '-')}\t{seven.get('utilization', '-')}"
              f"\t{(five.get('resets_at') or '-')[:16]}\tok")
    except Exception:
        print(f"{name}\t-\t-\t-\tfetch-error")
PYEOF
}

# Lowest 5-hour utilization wins; ties fall to 7-day, then list order.
# Updates the rotation pointer so --next continues from the pick.
# $1 (optional): profile to exclude (a resumed session's source).
pick_best() {
  pb_best="" pb_five=101 pb_seven=101
  while IFS="$(printf '\t')" read -r n five seven _ note; do
    [ "$note" = ok ] || continue
    [ "$n" = "${1:-}" ] && continue
    f=${five%.*} s=${seven%.*}
    case $f in ''|*[!0-9]*) continue ;; esac
    if [ "$f" -lt "$pb_five" ] || { [ "$f" -eq "$pb_five" ] && [ "$s" -lt "$pb_seven" ]; }; then
      pb_best=$n pb_five=$f pb_seven=$s
    fi
  done <<EOF
$(usage_table)
EOF
  [ -n "$pb_best" ] || return 1
  mkdir -p "$root"
  printf '%s' "$pb_best" > "$root/.rotation"
  echo "$pb_best"
}

cmd_best() {
  printf '%-14s %6s %6s %-18s %s\n' "PROFILE" "5H%" "7D%" "5H RESETS (UTC)" "NOTE"
  usage_table | while IFS="$(printf '\t')" read -r n five seven resets note; do
    [ "$note" = ok ] && note=""
    printf '%-14s %6s %6s %-18s %s\n' "$n" "$five" "$seven" "$resets" "$note"
  done
}

cmd_run() {
  usage="usage: claudes run <Profile|--next|--best> [--start-from-session=<id>] [claude args...]"
  name="" sess="" rotate=0 best=0
  while [ $# -gt 0 ]; do
    case $1 in
      --next) rotate=1; shift ;;
      --best) best=1; shift ;;
      --start-from-session=*) sess=${1#--start-from-session=}; shift ;;
      -*) break ;;  # remaining args belong to claude
      *) if [ -z "$name" ] && [ "$rotate" = 0 ] && [ "$best" = 0 ]; then name=$1; shift; else break; fi ;;
    esac
  done
  picks=$(( (rotate + best) + $( [ -n "$name" ] && echo 1 || echo 0 ) ))
  [ "$picks" = 1 ] || die "$usage (pick exactly one of a profile name, --next, --best)"
  command -v claude >/dev/null 2>&1 || die "Claude Code CLI not found — install it: npm install -g @anthropic-ai/claude-code"

  src=""
  if [ -n "$sess" ]; then
    hit=$(find_session "$sess") || die "session $sess not found in any profile"
    src=$(printf '%s\n' "$hit" | cut -f1)
  fi
  if [ "$rotate" = 1 ]; then
    name=$(rotation_next)
    [ -n "$sess" ] && [ "$name" = "$src" ] && name=$(rotation_next)  # already there; step past
    echo "claudes: rotating to profile '$name'" >&2
  elif [ "$best" = 1 ]; then
    name=$(pick_best "$src") || die "no profile with a readable token — run 'claudes best' to see why"
    echo "claudes: best available profile is '$name'" >&2
  else
    want=$name; name=$(resolve_profile "$want") || die "no profile named '$want' (see: claudes list)"
  fi

  if [ -n "$sess" ]; then
    [ "$src" = "$name" ] || cmd_transfer "$sess" --from "$src" --to "$name" >&2
    hit=$(find_session "$sess" "$name") || die "session $sess missing after transfer"
    cwd=$(session_meta "$(printf '%s\n' "$hit" | cut -f3)" | cut -f1)
    if [ -n "$cwd" ] && [ -d "$cwd" ]; then
      cd "$cwd"
    elif [ -n "$cwd" ]; then
      echo "claudes: project dir $cwd no longer exists; resuming from $PWD" >&2
    fi
    CLAUDE_CONFIG_DIR=$(config_dir "$name") exec claude --resume "$sess" "$@"
  fi
  CLAUDE_CONFIG_DIR=$(config_dir "$name") exec claude "$@"
}

# Keep profile shims beside this installation's `claudes` link.
bin_dir() {
  if [ -f "$root/.bin-dir" ]; then
    IFS= read -r d < "$root/.bin-dir" || d=""
    case $d in /opt/homebrew/bin|/usr/local/bin|"$HOME/.local/bin")
      if [ -L "$d/claudes" ] && [ "$(readlink "$d/claudes")" = "$self" ] && [ -w "$d" ]; then
        echo "$d"
        return 0
      fi
      ;;
    esac
  fi
  old_ifs=$IFS
  IFS=:
  result=""
  for d in $PATH; do
    case $d in /opt/homebrew/bin|/usr/local/bin|"$HOME/.local/bin") ;; *) continue ;; esac
    if [ -L "$d/claudes" ] && [ "$(readlink "$d/claudes")" = "$self" ] && [ -w "$d" ]; then
      result=$d
      break
    fi
  done
  IFS=$old_ifs
  if [ -n "$result" ]; then
    echo "$result"
    return 0
  fi

  # Upgrade path for releases that created the CLI link before .bin-dir existed.
  for d in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
    if [ -L "$d/claudes" ] && [ "$(readlink "$d/claudes")" = "$self" ] && [ -w "$d" ]; then
      mkdir -p "$root"
      printf '%s\n' "$d" > "$root/.bin-dir"
      echo "$d"
      return 0
    fi
  done
  return 1
}

# claude-as + claude-<profile> as real executables on PATH (symlinks to
# Resources/claude-as), so every app and script can pin a profile — a shell
# function only ever existed inside shells that sourced our helper.
cmd_shims() {
  remove=0
  [ "${1:-}" = --remove ] && remove=1
  src="$scripts_dir/claude-as"
  [ -f "$src" ] || src="$scripts_dir/shell/claude-as"  # dev-tree layout
  dir=$(bin_dir) || die "claudes command link not found; run install.sh again"
  mkdir -p "$root"
  lock_file="$root/.shims.lock"
  attempts=0
  until /usr/bin/shlock -f "$lock_file" -p $$; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt 100 ] || die "timed out waiting for another shim sync"
    sleep 0.1
  done
  cleanup_shim_lock() { rm -f "$lock_file"; }
  trap cleanup_shim_lock 0
  trap 'exit 1' 1 2 15

  wanted=""
  if [ "$remove" = 0 ]; then
    [ -x "$src" ] || die "shim script missing: $src"
    wanted=$({ echo "claude-as"; { echo Default; profile_names; } | sort -fu | while IFS= read -r n; do
      suffix=$(lower "$n")
      [ "$suffix" = as ] && continue
      echo "claude-$suffix"
    done; })
  fi

  # Prune ours only — identified by the symlink target, never a real command.
  for f in "$dir"/claude-*; do
    [ -L "$f" ] || continue
    [ "$(readlink "$f")" = "$src" ] || continue
    if ! printf '%s\n' "$wanted" | grep -qx "$(basename "$f")"; then
      rm -f "$f"
      echo "✓ removed $f"
    fi
  done
  [ "$remove" = 1 ] && return 0

  printf '%s\n' "$wanted" | while IFS= read -r b; do
    [ -n "$b" ] || continue
    existing=$(command -v "$b" 2>/dev/null || true)
    if [ -n "$existing" ] && [ "$existing" != "$dir/$b" ]; then
      echo "claudes: $b already resolves to $existing — skipped" >&2
      continue
    fi
    if [ -e "$dir/$b" ] || [ -L "$dir/$b" ]; then
      if [ ! -L "$dir/$b" ]; then
        echo "claudes: $dir/$b exists and isn't ours — skipped" >&2
        continue
      fi
      if [ "$(readlink "$dir/$b")" != "$src" ]; then
        echo "claudes: $dir/$b exists and isn't ours — skipped" >&2
        continue
      fi
    fi
    ln -sf "$src" "$dir/$b"
  done
  echo "✓ claude-as and claude-<profile> linked in $dir"
}

# Profile list changed: keep PATH in step, but never fail the operation over it.
sync_shims() {
  ( cmd_shims ) || echo "claudes: PATH shims not updated — run 'claudes shims'" >&2
}

cmd_new() {
  [ $# -ge 1 ] || die "usage: claudes new <Name>"
  "$scripts_dir/make-claude-profile.sh" "$1"
  sync_shims
}

cmd_repatch() {
  exec "$scripts_dir/repatch-claude-profiles.sh" "$@"
}

cmd_delete() {
  name="" everything=0 yes=0
  for arg in "$@"; do
    case $arg in
      --everything) everything=1 ;;
      --yes) yes=1 ;;
      -*) die "unknown flag: $arg" ;;
      *) name=$arg ;;
    esac
  done
  [ -n "$name" ] || die "usage: claudes delete <Name> [--everything] [--yes]"
  want=$name; name=$(resolve_profile "$want") || die "no profile named '$want'"
  [ "$name" = Default ] && die "Default can't be deleted"
  [ "$(active_profile)" = "$name" ] && die "'$name' is the active profile — run 'claudes use <other>' first"
  profile_running "$name" && die "'$name' is running — quit it first"

  app="/Applications/Claude-$name.app"
  data="$HOME/Library/Application Support/Claude-$name"
  cfg="$root/$name"
  if [ "$yes" -eq 0 ]; then
    if [ "$everything" -eq 1 ]; then extra=" AND its data/config"; else extra=""; fi
    printf "Delete profile '%s'%s? [y/N] " "$name" "$extra"
    read -r reply
    case $(lower "$reply") in y*) ;; *) echo "aborted"; exit 1 ;; esac
  fi
  [ -d "$app" ] && rm -rf "$app"
  if [ "$everything" -eq 1 ]; then
    [ -d "$data" ] && rm -rf "$data"
    [ -d "$cfg" ] && rm -rf "$cfg"
    echo "Deleted '$name' (app, data, config)"
  else
    echo "Deleted '$name' (app only)"
  fi
  sync_shims
}

# First "cwd" and first user prompt from the head of a session transcript.
session_meta() {  # path -> cwd \t snippet
  head=$(head -c 16384 "$1" 2>/dev/null || true)
  cwd=$(printf '%s' "$head" | grep -o '"cwd":"[^"]*"' | head -1 | sed 's/^"cwd":"//; s/"$//')
  snippet=$(printf '%s' "$head" | grep -o '"content":"[^"]*' | head -1 | cut -c12- | cut -c1-70)
  if [ -z "$snippet" ]; then
    snippet=$(printf '%s' "$head" | grep -o '"text":"[^"]*' | head -1 | cut -c9- | cut -c1-70)
  fi
  # JSON escapes read poorly in a table — flatten \n/\t to spaces, unescape quotes.
  snippet=$(printf '%s' "$snippet" | sed 's/\\[nt]/ /g; s/\\"/"/g')
  printf '%s\t%s\n' "$cwd" "${snippet:-(no prompt)}"
}

# Locate a session's transcript. Echoes "profile<TAB>config-dir<TAB>jsonl";
# searches every profile when no profile is given.
find_session() {
  fs_id=$1
  if [ -n "${2:-}" ]; then
    fs_cfg=$(config_dir "$2")
    for fs_f in "$fs_cfg"/projects/*/"$fs_id".jsonl; do
      [ -e "$fs_f" ] && printf '%s\t%s\t%s\n' "$2" "$fs_cfg" "$fs_f" && return 0
    done
    return 1
  fi
  for fs_n in $( { echo Default; profile_names; } | sort -fu ); do
    fs_cfg=$(config_dir "$fs_n")
    for fs_f in "$fs_cfg"/projects/*/"$fs_id".jsonl; do
      [ -e "$fs_f" ] && printf '%s\t%s\t%s\n' "$fs_n" "$fs_cfg" "$fs_f" && return 0
    done
  done
  return 1
}

cmd_sessions() {
  name=$(resolve_profile "${1:-Default}") || die "no profile named '$1'"
  cfg=$(config_dir "$name")
  found=0
  # shellcheck disable=SC2045
  for f in "$cfg"/projects/*/*.jsonl; do
    [ -e "$f" ] || continue
    found=1
    stat -f '%m %N' "$f"
  done | sort -rn | while IFS= read -r line; do
    f=${line#* }
    meta=$(session_meta "$f")
    cwd=${meta%%	*}
    if [ -n "$cwd" ]; then proj=$(basename "$cwd"); else proj=$(basename "$(dirname "$f")"); fi
    id=$(basename "$f" .jsonl)
    printf '%s  %s  %-20s  %s\n' \
      "$id" \
      "$(date -r "${line%% *}" '+%Y-%m-%d %H:%M')" \
      "$proj" \
      "${meta#*	}"
  done
  # The pipeline runs in a subshell; re-check emptiness directly.
  for f in "$cfg"/projects/*/*.jsonl; do
    [ -e "$f" ] && return 0
  done
  die "no sessions in '$name' ($cfg/projects)"
}

cmd_transfer() {
  id="" from="" to="" prev=""
  for arg in "$@"; do
    case $prev in
      --to) to=$arg; prev=""; continue ;;
      --from) from=$arg; prev=""; continue ;;
    esac
    case $arg in
      --to|--from) prev=$arg ;;
      --next) to="--next" ;;
      --best) to="--best" ;;
      -*) die "unknown flag: $arg" ;;
      *) id=$arg ;;
    esac
  done
  { [ -n "$id" ] && [ -n "$to" ]; } || die "usage: claudes transfer <id> --to <Profile>|--next|--best [--from <Profile>]"
  case $to in --next|--best) ;; *)
    want=$to; to=$(resolve_profile "$want") || die "no profile named '$want'"
  esac

  # Locate the source transcript: given profile, or search all of them.
  if [ -n "$from" ]; then
    want=$from; from=$(resolve_profile "$want") || die "no profile named '$want'"
    hit=$(find_session "$id" "$from") || die "session $id not found in '$from'"
  else
    hit=$(find_session "$id") || die "session $id not found in any profile"
    from=$(printf '%s\n' "$hit" | cut -f1)
  fi
  src_cfg=$(printf '%s\n' "$hit" | cut -f2)
  jsonl=$(printf '%s\n' "$hit" | cut -f3)
  if [ "$to" = "--next" ]; then
    to=$(rotation_next)
    [ "$to" = "$from" ] && to=$(rotation_next)  # rotating onto the source is a no-op; step past it
    echo "claudes: rotating to profile '$to'" >&2
  elif [ "$to" = "--best" ]; then
    to=$(pick_best "$from") || die "no profile with a readable token — run 'claudes best' to see why"
    echo "claudes: best available profile is '$to'" >&2
  fi
  [ "$from" = "$to" ] && die "session is already in '$to'"

  dst_cfg=$(config_dir "$to")
  slug=$(basename "$(dirname "$jsonl")")
  dst="$dst_cfg/projects/$slug/$id.jsonl"
  [ -e "$dst" ] && die "'$to' already has session $id"
  mkdir -p "$dst_cfg/projects/$slug"
  mv "$jsonl" "$dst"

  # Per-session side data (env, edited-file history, todos) — best-effort.
  for sub in "session-env/$id" "file-history/$id"; do
    if [ -e "$src_cfg/$sub" ] && [ ! -e "$dst_cfg/$sub" ]; then
      mkdir -p "$dst_cfg/$(dirname "$sub")"
      mv "$src_cfg/$sub" "$dst_cfg/$sub" 2>/dev/null || true
    fi
  done
  for f in "$src_cfg"/todos/"$id"*; do
    [ -e "$f" ] || continue
    mkdir -p "$dst_cfg/todos"
    mv "$f" "$dst_cfg/todos/" 2>/dev/null || true
  done

  cwd=$(session_meta "$dst" | cut -f1)
  # env-prefix form works in zsh, bash, AND fish (VAR=x cmd does not).
  if [ "$to" = Default ] && [ ! -L "$dot" ]; then
    invoke="claude --resume $id"
  else
    invoke="env CLAUDE_CONFIG_DIR=\"\$HOME/.claude-profiles/$to\" claude --resume $id"
  fi
  echo "Moved session $id: $from -> $to"
  if [ -n "$cwd" ]; then
    echo "Resume: cd \"$cwd\" && $invoke"
  else
    echo "Resume: $invoke"
  fi
}

cmd_desktop() {
  if [ "${1:-}" = --next ]; then
    name=$(rotation_next)
    echo "claudes: rotating to profile '$name'" >&2
  elif [ "${1:-}" = --best ]; then
    name=$(pick_best) || die "no profile with a readable token — run 'claudes best' to see why"
    echo "claudes: best available profile is '$name'" >&2
  else
    name=$(resolve_profile "${1:-Default}") || die "no profile named '$1'"
  fi
  if [ "$name" = Default ]; then
    open -a "/Applications/Claude.app"
  else
    open -a "/Applications/Claude-$name.app"
  fi
}

cmd_version() {
  plist="$scripts_dir/../Info.plist"
  if [ -f "$plist" ]; then
    /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist"
  else
    git -C "$scripts_dir" describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || echo "0.0.0"
  fi
}

cmd_profiles() {
  { echo Default; profile_names; } | sort -fu
}

cmd_help() {
  sed -n '5,18p' "$self" | sed 's/^# \{0,3\}//'
}

cmd=${1:-help}
[ $# -ge 1 ] && shift
case $cmd in
  list)     cmd_list "$@" ;;
  active)   active_profile ;;
  use)      cmd_use "$@" ;;
  run)      cmd_run "$@" ;;
  best)     cmd_best "$@" ;;
  new)      cmd_new "$@" ;;
  delete)   cmd_delete "$@" ;;
  repatch)  cmd_repatch "$@" ;;
  sessions) cmd_sessions "$@" ;;
  transfer) cmd_transfer "$@" ;;
  desktop)  cmd_desktop "$@" ;;
  shims)    cmd_shims "$@" ;;
  profiles) cmd_profiles ;;
  version)  cmd_version ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command: $cmd (try: claudes help)" ;;
esac
