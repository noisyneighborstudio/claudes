#!/bin/sh
# claude-as — run Claude Code pinned to a profile, from ANY shell or app.
#
#   claude-as <Profile|--next|--best> [claude args…]
#   claude-<profile> [claude args…]     e.g. claude-work (symlink to this file)
#
# These are real executables on PATH, not shell functions, so editors, GUI
# apps, scripts and non-interactive shells can use them too. `claudes shims`
# creates/removes the symlinks as profiles come and go.
set -eu

invoked=$(basename "$0")

# Resolve symlinks to find the sibling `claudes` CLI — this file lives in
# Claudes.app/Contents/Resources; the PATH entries are symlinks to it.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
dir=$(cd "$(dirname "$self")" && pwd)
cli=$dir/claudes
[ -x "$cli" ] || cli=$dir/../claudes  # dev-tree layout: shell/claude-as
[ -x "$cli" ] || { echo "$invoked: claudes CLI not found next to $self" >&2; exit 1; }

if [ "$invoked" = claude-as ]; then
  if [ $# -lt 1 ]; then
    echo "usage: claude-as <Profile|--next|--best> [claude args…]" >&2
    "$cli" list >&2
    exit 1
  fi
  exec "$cli" run "$@"
fi

exec "$cli" run "${invoked#claude-}" "$@"
